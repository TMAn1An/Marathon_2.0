APP_NAME="Community 10K Marathon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Use sqlite for local dev. Production options: mysql, pgsql, or `turso` (libSQL over HTTP,
# works on Vercel). For turso set TURSO_URL (https://<db>-<org>.<region>.turso.io) and TURSO_TOKEN.
DB_CONNECTION=sqlite
# TURSO_URL=
# TURSO_TOKEN=
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marathon
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Marathon event configuration
MARATHON_EVENT_NAME="Community 10K Marathon"
MARATHON_EVENT_TAGLINE="A community run for everyone: first-timers, club runners and families."
MARATHON_DISTANCE_KM=10
MARATHON_CURRENCY=BDT
MARATHON_EVENT_DATE="2026-12-12"
MARATHON_EVENT_VENUE="City Central Park"
# Map embed URL for the route page (OpenStreetMap "Share > HTML" src). Empty hides the map.
MARATHON_MAP_EMBED_URL=
MARATHON_EVENT_ORGANIZER="Marathon Organizing Committee"
# Optional external results board; leave empty to use the built-in results page.
MARATHON_RESULT_URL=
MARATHON_SUPPORT_EMAIL="hello@example.com"
MARATHON_TOTAL_SLOTS=400
MARATHON_HOLD_MINUTES=10
# Payments: "manual" (runner pays merchant number, admin verifies TrxID) or
# "simulated" (demo only – refused when APP_ENV=production).
MARATHON_PAYMENT_MODE=simulated
MARATHON_BKASH_NUMBER=
MARATHON_NAGAD_NUMBER=
MARATHON_VERIFICATION_HOLD_HOURS=48
MARATHON_CERT_REQUIRE_FINISH=true
# Categories are defined in config/marathon.php; these set their fees (BDT).
MARATHON_FEE_OPEN=800
MARATHON_FEE_STUDENT=500
MARATHON_BIB_PREFIX=RUN
MARATHON_BIB_PAD_LENGTH=4
MARATHON_VERIFY_URL=http://localhost:5173/verify/{uuid}

# First admin (used by `php artisan db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-use
SANCTUM_TOKEN_EXPIRATION=720

# Sanctum / API auth
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
