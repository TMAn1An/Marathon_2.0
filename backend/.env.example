APP_NAME="IUBAT SCSE MINI Marathon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Use sqlite for local dev; switch to mysql for production.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marathon
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="marathon@iubat.edu"
MAIL_FROM_NAME="${APP_NAME}"

# Platform branding
MARATHON_PLATFORM_NAME="IUBAT SCSE MINI Marathon"
MARATHON_ORGANIZER="IUBAT School of Computer Science & Engineering"
MARATHON_SUPPORT_EMAIL="marathon@iubat.edu"
MARATHON_FRONTEND_URL=http://localhost:5173

# Default event values
MARATHON_TOTAL_SLOTS=400
MARATHON_GUEST_SLOT_LIMIT=30
MARATHON_HOLD_MINUTES=10
MARATHON_FEE_STUDENT=500
MARATHON_FEE_FACULTY=800

# Registration unlock (global). Per-event registration_start_date overrides this.
MARATHON_REGISTRATION_UNLOCK_AT="2026-05-20 00:00:00"
MARATHON_TIMEZONE=Asia/Dhaka

# BIB generation
MARATHON_BIB_PREFIX=MIN
MARATHON_BIB_SEPARATOR=_
MARATHON_BIB_PAD_LENGTH=4

MARATHON_VERIFY_URL=http://localhost:5173/verify/{uuid}

# Sanctum / API auth
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
